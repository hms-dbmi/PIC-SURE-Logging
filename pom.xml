<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Self-contained on the Spring parent. Consolidation Phase 4 swaps this <parent>
         for the monorepo root pic-sure-api and deletes the <properties> below; the
         pic-sure BOM and pic-sure-spring-commons are NOT published anywhere this
         standalone repo's CI can reach them. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.9</version>
        <relativePath/>
    </parent>

    <groupId>edu.harvard.dbmi.avillach</groupId>
    <artifactId>pic-sure-logging</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>PIC-SURE Audit Logging Service</name>

    <properties>
        <java.version>25</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Not governed by the Spring BOM. -->
        <java-jwt.version>4.4.0</java-jwt.version>
        <logstash-logback-encoder.version>8.1</logstash-logback-encoder.version>
        <!-- Overrides spring-boot-dependencies 3.5.9, which manages Mockito 5.17.0.
             5.17.0's inline mock maker cannot instrument on JDK 25 ("Could not modify
             all classes"); 5.18.0 is the verified floor. Remove this override only after
             confirming the then-current Spring BOM manages >= 5.18.0. -->
        <mockito.version>5.18.0</mockito.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- JWT: decode only, never verified. -->
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>${java-jwt.version}</version>
        </dependency>

        <!-- The AUDIT channel's encoder. Its [ignore] fieldNames are what make the
             emitted line a bare field map; Boot's built-in JsonEncoder cannot do this. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash-logback-encoder.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
